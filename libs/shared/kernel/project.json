{
  "name": "shared-kernel",
  "tags": ["scope:shared", "type:util"],
  "sourceRoot": "libs/shared/kernel/src",
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/kernel",
        "main": "libs/shared/kernel/src/index.ts",
        "tsConfig": "libs/shared/kernel/tsconfig.lib.json",
        "platform": "node"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared/kernel/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
